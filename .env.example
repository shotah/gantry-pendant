# Worker app env (local .env / wrangler secret put). Not Cloudflare account
# credentials. Local deploy: `npx wrangler login`. CI: GitHub secrets
# CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID, variable DIRECTORY_KV_ID.
# See docs/deployment.md.

# Spike (two browser tabs). Gone once Google + crane bearers are set.
MAILBOX_SECRET=

# Loopback-only mock mouth (`npm run dev`). Never set on workers.dev.
# PENDANT_DEV=1

# Production human login — new Web application client on the same GCP
# project as google-mcp. Scopes: openid email profile only.
# Redirect: https://<this-origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Optional yard-wide extra. The crane list is the door.
# ALLOWED_SUBS=1182…:ada@example.com,1183…:kit@example.com
ALLOWED_SUBS=

# Crane bearer bound to slug. Kit's token cannot join Ada's room.
# CRANE_BEARERS=kit:<random>,ada:<random>
CRANE_BEARERS=
