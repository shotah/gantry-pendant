{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gantry-pendant",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Mailbox",
        "name": "MAILBOX"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DIRECTORY",
      // wrangler kv namespace create DIRECTORY — paste the id, or set GitHub variable DIRECTORY_KV_ID
      "id": "directory-local",
      "preview_id": "directory-local"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Mailbox"]
    }
  ]
  // Optional wrangler var (not a secret): LOCATION_HINT=wnam|enam|weur|eeur|apac|…
  // First MAILBOX.get() pins the Durable Object. Set near the Mini.
  // Optional wrangler var (not a secret): TTS_VOICE=en-US-Chirp3-HD-Leda
  // Kit's Chirp 3 HD voice for hold-to-talk. The key is the GOOGLE_TTS_API_KEY secret.
  // Optional wrangler var: VOICE=on|off — pocket voice flag. Unset follows the key.
}
